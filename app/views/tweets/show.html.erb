<%= stylesheet_link_tag 'show_tweets', media: "all" %>

<div class="show-container">

  <div class="show-title">
    投稿詳細
  </div>

  <div class="tweet-card">

    <div class="tweet-body">
      <%= @tweet.body %>
    </div>

    <div class="tweet-date">
      <%= @tweet.created_at.strftime("%Y-%m-%d %H:%M") %>
    </div>

    <div class="tag-area">
      <% @tags.each do |tag| %>
        <% if tag.tweets.count > 0 %>
          #<%= link_to tag.tag_name,
              tag_tweets_path(tag_id: tag.id) %>
          (<%= tag.tweets.count %>)
        <% end %>
      <% end %>
    </div>

    <div class="like-area">
      <% if user_signed_in? %>

        <% if current_user.already_liked?(@tweet) %>

          <%= link_to tweet_like_path(@tweet),
              data: { turbo_method: :delete },
              class: "like-btn" do %>

            ♥ いいね取り消し
            (<%= @tweet.likes.count %>)

          <% end %>

        <% else %>

          <%= link_to tweet_likes_path(@tweet),
              data: { turbo_method: :post },
              class: "like-btn" do %>

            ♡ いいね
            (<%= @tweet.likes.count %>)

          <% end %>

        <% end %>

      <% else %>

        ♥ <%= @tweet.likes.count %>

      <% end %>
    </div>

    <div class="edit-link">
      <%= link_to "編集する", edit_tweet_path(@tweet.id) %>
    </div>

  </div>

  <div class="comment-card">

    <h3>コメント一覧 
      <span class="comment-count-text">
        <%= @comments.count %>件のコメント
      </span>
    </h3>

    <% @comments.each do |c| %>

      <div class="comment">

        <p>
          <strong>
            <%= c.user.name unless c.user.blank? %>
          </strong>
        </p>

        <p><%= c.reply %></p>

      </div>

    <% end %>

    <% if user_signed_in? %>

      <%= form_with(model: [@tweet, @comment], local: true) do |f| %>

        <%= f.text_area :reply %>

        <div class="comment-button">
          <%= f.submit "コメントする" %>
        </div>

      <% end %>

    <% end %>

  </div>

  <div class="back-link">
    <%= link_to "一覧に戻る", tweets_path %>
  </div>

</div>