<%= stylesheet_link_tag 'show_tweets', :media => "all" %>

<h2><p><span class = "title">投稿詳細</p></h2>
<br>
<div class = 'content'>
  <div class = 'tweet'>
  <p><%= @tweet.body %></p>
  <p><%= @tweet.created_at %></p>

  <% @tags.each do |tag| %>
  <% if tag.tweets.count > 0 %>
  #<%= link_to tag.tag_name, tag_tweets_path(tag_id: tag.id) %>
  <%= "(#{tag.tweets.count})" %>
  <% end %>
  <% end %>

  <!-- いいね機能の追加 -->
  <% if user_signed_in? %>
  <% if current_user.already_liked?(@tweet) %>
  <%= link_to tweet_like_path(@tweet), data:{turbo_method: :delete} do %>
  <p>いいねを取り消す</p><%= @tweet.likes.count %>
  <% end %>
  <% else %>
  <%= link_to tweet_likes_path(@tweet), data: {turbo_method: :post} do %>
  <p>いいね</p><%= @tweet.likes.count %>
  <% end %>
  <% end %>
  <% else %>
  <p>いいねの数 = </p><%= @tweet.likes.count %>
  <% end %>
  <br> <%= link_to "編集する", edit_tweet_path(@tweet.id) %>    
  </div>
  <br>
  <div class ="comment-wrapper">
  <p>コメント一覧</p>
  <% @comments.each do |c| %>
  <div>
    <p>ユーザー名:<%= c.user.name unless c.user.blank? %></p>
    <%= c.reply %>
    </div>
        <br>
  <% end %>

  <% if user_signed_in? %>
  <%= form_with(model: [@tweet, @comment], local: true) do |f| %>
    <%= f.text_area :reply %>
    <%= button_tag type: "submit" do %>
        <i class="far fa-comments"></i>コメントする
    <% end %>
  <% end %>
  <% end %>
  </div>

  <%= link_to "Tweet一覧に戻る",tweets_path %>
</div>